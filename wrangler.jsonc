{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sunlo",
	// No "main": @flue/vite sets it to its generated Worker entry, which serves
	// .flue/app.ts and exports one Durable Object class per agent.
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// No custom domain yet: production serves at sunlo.<subdomain>.workers.dev.
	// To move sunlo.app here, add
	// "routes": [{ "pattern": "sunlo.app", "custom_domain": true }].
	"preview_urls": true,
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Every other path is a static file and never runs the worker.
		// /learn/* runs it so that crawlers get Open Graph tags.
		"run_worker_first": ["/api/*", "/learn/*"],
	},
	"ai": { "binding": "AI", "remote": true },
	"ratelimits": [
		{
			"name": "EXTRACT_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 },
		},
		{
			// Per message to the coach; the agent's own steps are not counted.
			"name": "COACH_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 20, "period": 60 },
		},
		{
			// Search runs as the learner types, so this is per debounced query.
			"name": "SEARCH_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 120, "period": 60 },
		},
	],
	// Append-only once deployed: a new Flue agent is a new entry.
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlueCoachAgent"] }],
	// Production values, all public. Workers Builds deploys these on a push
	// to main; its VITE_SUPABASE_* build variables must match them.
	// scripts/cf-preview.sh overrides the Supabase pair with --var.
	"vars": {
		"PHOTO_EXTRACT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
		"COACH_MODEL": "@cf/google/gemma-4-26b-a4b-it",
		// Must exist in the AI Gateway dashboard; only `default` is created on demand.
		"AI_GATEWAY_ID": "sunlo-app",
		"SUPABASE_URL": "https://hepudeougzlgnuqvybrj.supabase.co",
		"SUPABASE_ANON_KEY": "sb_publishable_3Vu41i9KARrrirkDEZxDSA_COkuhNCf",
	},
	// Worker Previews, which scripts/cf-preview.sh makes for each PR with
	// `wrangler preview`. Nothing here is inherited from the top level, so a
	// new var or binding goes in both places. vite.config.ts copies Flue's
	// agent bindings in at build time, so never list them.
	"previews": {
		// No SUPABASE_URL or SUPABASE_ANON_KEY: cf-preview.sh always sets both
		// with --var, and the preview workflow reads production's pair from
		// this file with a grep that must find each name only once.
		"vars": {
			"PHOTO_EXTRACT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
			"COACH_MODEL": "@cf/google/gemma-4-26b-a4b-it",
			"AI_GATEWAY_ID": "sunlo-app",
		},
		"ai": { "binding": "AI" },
		// Their own namespaces, so preview traffic never counts against a
		// production user's limit.
		"ratelimits": [
			{
				"name": "EXTRACT_LIMITER",
				"namespace_id": "2001",
				"simple": { "limit": 10, "period": 60 },
			},
			{
				"name": "COACH_LIMITER",
				"namespace_id": "2002",
				"simple": { "limit": 20, "period": 60 },
			},
			{
				"name": "SEARCH_LIMITER",
				"namespace_id": "2003",
				"simple": { "limit": 120, "period": 60 },
			},
		],
	},
}
