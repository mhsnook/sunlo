{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sunlo",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	// No custom domain yet: production serves at sunlo.<subdomain>.workers.dev.
	// To move sunlo.app here, add
	// "routes": [{ "pattern": "sunlo.app", "custom_domain": true }].
	"preview_urls": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Every other path is a static file and never runs the worker.
		// /learn/* runs it so that crawlers get Open Graph tags.
		"run_worker_first": ["/api/*", "/learn/*"],
	},
	"ai": { "binding": "AI", "remote": true },
	"ratelimits": [
		{
			"name": "EXTRACT_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 },
		},
	],
	// SUPABASE_URL and SUPABASE_ANON_KEY are not here: scripts/cf-deploy.sh
	// passes them with --var, from the values the Vite build used.
	"vars": {
		"PHOTO_EXTRACT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
	},
}
