# cp .env.example .env
VITE_SUPABASE_URL="http://localhost:54321"
VITE_SUPABASE_ANON_KEY=""
# The public https origin this build points at for links that LEAVE the app —
# shared URLs, QR codes, and auth email redirects. Required for native builds,
# where window.location.origin is https://localhost.
VITE_PUBLIC_ORIGIN="https://sunlo.app"

# used for playwright e2e tests
SUPABASE_SERVICE_ROLE_KEY=""

# Build/deploy details
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
APPLE_DEVELOPMENT_TEAM="app.sunlo.dev"
