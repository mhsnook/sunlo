{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sunlo-admin",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	// postgres.js needs node:net and node:tls.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Every other path is a static file and never runs the worker.
		"run_worker_first": ["/api/*"],
	},
	"preview_urls": true,
	// The usage reporter (worker/reporter/agent.ts). One instance, named
	// "team", keeps its reports and notes in its own SQLite.
	"ai": { "binding": "AI" },
	"durable_objects": {
		"bindings": [{ "name": "REPORTER", "class_name": "Reporter" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reporter"] }],
	"routes": [
		{
			"pattern": "admin.sunlo.app",
			"custom_domain": true,
		},
	],
	// The database, as the read-only admin_reader role. The Hyperdrive config
	// holds the production connection string (docs/deployment.md,
	// "Cloudflare" › "Setup"); `wrangler dev` connects to the local string.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "d22b56aafb6c420781c880b4c6777490",
			"localConnectionString": "postgresql://admin_reader:admin_reader@127.0.0.1:54322/postgres",
		},
	],
	// Production values, both public, the same as the root wrangler.jsonc.
	// Three optional secrets, set with `wrangler secret put`, let the usage
	// reporter file GitHub issues: GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID
	// and GITHUB_APP_PRIVATE_KEY.
	"vars": {
		"SUPABASE_URL": "https://hepudeougzlgnuqvybrj.supabase.co",
		"SUPABASE_ANON_KEY": "sb_publishable_3Vu41i9KARrrirkDEZxDSA_COkuhNCf",
		// Where the usage reporter files issues, when the GitHub App secrets
		// are set (README.md, "Filing GitHub issues").
		"GITHUB_REPO": "mhsnook/sunlo",
		// The Workers AI model the usage reporter runs on. Any model that
		// takes tools works; @cf/deepseek-ai/deepseek-v4-pro-0813 is the
		// other one we considered.
		"REPORTER_MODEL": "@cf/moonshotai/kimi-k2.6",
	},
}
